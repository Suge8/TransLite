{
  "name": "translite",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "license": "GPL-3.0-or-later",
  "description": "TransLite browser extension for web page and subtitle translation",
  "scripts": {
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:analyze": "wxt build --analyze",
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox --mv3",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "WXT_SKIP_ENV_VALIDATION=true wxt prepare",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "scrape:ai-sdk-models": "npx tsx scripts/scrape-ai-sdk-provider-models.ts --out scripts/output/ai-sdk-provider-models.json",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "zip:all": "pnpm zip && pnpm zip:edge && pnpm zip:firefox"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/google": "^3.0.79",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@base-ui/react": "^1.5.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@t3-oss/env-core": "^0.13.11",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/hotkeys": "^0.8.0",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-query": "^5.100.14",
    "@webext-core/messaging": "^3.0.1",
    "@wxt-dev/i18n": "^0.2.5",
    "ai": "^6.0.191",
    "case-anything": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "debounce": "^3.0.0",
    "deepmerge-ts": "^7.1.5",
    "dequal": "^2.0.3",
    "dexie": "^4.4.2",
    "entities": "^8.0.0",
    "file-saver": "^2.0.5",
    "franc": "^6.2.0",
    "jotai": "^2.20.0",
    "jotai-family": "^1.0.2",
    "js-sha256": "^0.11.1",
    "ollama-ai-provider-v2": "^3.5.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "react-router": "^7.15.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@eslint-react/eslint-plugin": "^5.8.5",
    "@faker-js/faker": "^10.4.0",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/eslint-plugin-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^28.0.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-istanbul": "^4.1.7",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "postcss-rem-to-responsive-pixel": "^7.0.4",
    "postcss-value-parser": "^4.2.0",
    "tailwindcss": "^4.3.0",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wxt": "0.20.26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0",
      "onFail": "download"
    }
  }
}
